---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Creative Dynasty Events — Where Creativity Meets Community",
  description = "Curated paint experiences designed to bring people together, spark creativity, and support local businesses.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// VERIFIED-ONLY structured data (AUDIT.md §4): name, url, description.
// Deliberately omits address, telephone, sameAs (social), aggregateRating,
// and priceRange — none are confirmed. Per this project's rule, a field
// that needs owner confirmation is left out entirely rather than filled
// with an unverified or invented value.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Creative Dynasty Events",
  url: Astro.site?.toString(),
  description:
    "Curated paint experiences designed to bring people together, spark creativity, and support local businesses.",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!--
      This is a temporary pre-launch preview, not the production site.
      noindex prevents it from ever being indexed under this domain, so it
      can't be mistaken for (or outrank) the real site once launched.
      Remove this tag only when the owner approves going live on the real
      production domain — see HANDOFF.md governing rules.
    -->
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Creative Dynasty Events" />
    <!-- og:image intentionally omitted: no approved social-share image
         exists yet (see HANDOFF.md Creative Asset Plan). -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
