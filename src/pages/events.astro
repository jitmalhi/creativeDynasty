---
// VERIFIED (AUDIT.md §4) — hero copy and category descriptions verbatim
// from the live /events page. The live page also shows a "Limited spots
// available" banner directly above its own "No events at the moment"
// message — a contradiction flagged in AUDIT.md §2 — deliberately not
// reproduced here.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import TestimonialsGrid from "../components/ui/TestimonialsGrid.astro";
import Button from "../components/ui/Button.astro";
import Events from "../components/Events.astro";
import { testimonials } from "../data/testimonials";

const categories = [
  {
    title: "Social Experiences",
    body: "Designed for connection, fun, and a vibrant atmosphere. Perfect for friends, date nights, and solo attendees looking to enjoy a creative and engaging environment.",
  },
  {
    title: "Networking & Community",
    body: "Experiences created to bring people together through conversation, collaboration, and creativity while supporting and highlighting local businesses.",
  },
  {
    title: "Family-Friendly",
    body: "Creative experiences designed for children and parents to connect, explore, and enjoy meaningful moments together in a fun and welcoming space.",
  },
];

// The Events page's own unattributed quotes (AUDIT.md §4).
const eventsTestimonials = testimonials.filter((t) => !t.name);
---

<Layout
  title="Events — Creative Dynasty Events"
  description="Find the event that aligns with your energy, intention, and moment."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Explore Experiences"
      title="Explore Experiences"
      subtitle="Find the event that aligns with your energy, intention, and moment."
    />

    <Events />

    <!--
      Checkpoint 5: was a 3-column bordered-card grid, identical in
      treatment to About's pillars and Contact's help cards, and sitting
      directly above another 3-column grid (testimonials) below — the
      most blatant back-to-back repetition on the site (Checkpoint 4
      finding). Reworked as a compact numbered list instead, reusing the
      pattern already established (and praised) on Private Bookings'
      "How It Works" rather than inventing a new visual treatment.
    -->
    <section class="bg-ink-soft py-20 sm:py-28">
      <div class="mx-auto max-w-3xl px-6 lg:px-10">
        <SectionHeading eyebrow="Categories" heading="Find the Experience That Fits You" />
        <ol class="divide-y divide-line border-y border-line">
          {
            categories.map((c, i) => (
              <li class="flex gap-5 py-6">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-terracotta/40 font-display text-base text-terracotta">
                  {i + 1}
                </span>
                <div>
                  <h3 class="font-display text-lg text-paper">{c.title}</h3>
                  <p class="mt-1.5 text-sm text-smoke">{c.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <TestimonialsGrid
      items={eventsTestimonials}
      eyebrow="What People Are Saying"
      heading="From Past Events"
    />

    <!-- Checkpoint 5: stronger private-booking transition, per instruction. -->
    <section class="bg-ink-soft py-16">
      <div class="mx-auto max-w-xl px-6 text-center lg:px-10">
        <h2 class="font-display text-balance text-2xl text-paper sm:text-3xl">
          Don't want to wait for a public event?
        </h2>
        <p class="mt-3 text-smoke">
          Book a private experience for your own group, any time.
        </p>
        <div class="mt-6">
          <Button href="/private-bookings" variant="primary">Book a Private Experience</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
