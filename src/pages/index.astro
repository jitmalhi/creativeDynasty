---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import CredibilityStrip from "../components/CredibilityStrip.astro";
import WhyChooseUs from "../components/home/WhyChooseUs.astro";
import SignatureExperiences from "../components/home/SignatureExperiences.astro";
import Gallery from "../components/Gallery.astro";
import RootedInCommunity from "../components/home/RootedInCommunity.astro";
import FounderTeaser from "../components/home/FounderTeaser.astro";
import TestimonialsGrid from "../components/ui/TestimonialsGrid.astro";
import FinalCTA from "../components/home/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import { testimonials } from "../data/testimonials";

// Home shows the 3 attributed testimonials (matches the live Home page's
// placement — AUDIT.md §4). The other 3 unattributed quotes live on /events.
const homeTestimonials = testimonials.filter((t) => t.name);
---

<Layout>
  <Header onDark />
  <main>
    <Hero />
    <CredibilityStrip />
    <WhyChooseUs />
    <!--
      Checkpoint 5: FounderTeaser moved here (was after RootedInCommunity,
      ~60-70% down the page) per Checkpoint 4's own recommendation —
      establish trust in the person behind the brand before the sales
      pitch (experience cards, gallery), not after.
    -->
    <FounderTeaser />
    <SignatureExperiences />
    <Gallery />
    <RootedInCommunity />
    <TestimonialsGrid items={homeTestimonials} />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
