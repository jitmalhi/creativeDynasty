---
// VERIFIED (AUDIT.md §4) — verbatim from the live /private-bookings page
// unless noted. Pricing, capacity, turnaround times, and guarantees are
// deliberately absent — none were confirmed by the audit.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import ExperienceCard from "../components/ui/ExperienceCard.astro";
import ContactInfoPanel from "../components/ui/ContactInfoPanel.astro";
import FAQ from "../components/ui/FAQ.astro";
import { experiences } from "../data/experiences";
import { bookingFaq } from "../data/faq";

const perfectFor = [
  { emoji: "🎉", label: "Birthdays & Celebrations" },
  { emoji: "💼", label: "Corporate Teams" },
  { emoji: "🤝", label: "Community Groups" },
  { emoji: "👨‍👩‍👧", label: "Families & Youth" },
];

const included = [
  "Guided paint experience (no experience needed)",
  "All materials provided",
  "Curated meal included",
  "Custom theme options",
  "Setup and facilitation",
  "Engaging and welcoming atmosphere",
];

const steps = [
  { title: "Submit Your Request", body: "Tell us about your event, group size, and preferred date." },
  { title: "Customize Your Experience", body: "We tailor the experience, including theme and food options." },
  { title: "Show Up & Enjoy", body: "We handle everything so you can focus on the experience." },
];
---

<Layout
  showBookingBar={false}
  title="Private Bookings — Creative Dynasty Events"
  description="A fully guided creative experience paired with a flavorful meal, designed to bring people together in a meaningful and memorable way."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Private Bookings"
      title="Book a Private Paint, Dine & Connect Experience"
      subtitle="A fully guided creative experience paired with a flavorful meal, designed to bring people together in a meaningful and memorable way."
    />

    <section class="bg-ink py-20 sm:py-28">
      <div class="mx-auto max-w-3xl px-6 text-center lg:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">More Than an Event</p>
        <p class="mt-5 text-lg text-smoke">
          Creative Dynasty experiences are designed to go beyond traditional paint events. Each
          experience blends creativity, food, and connection to create an atmosphere that feels
          engaging, social, and complete.
        </p>
      </div>
    </section>

    <section class="bg-ink-soft py-20 sm:py-28">
      <div class="mx-auto max-w-5xl px-6 lg:px-10">
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
          <div>
            <h2 class="font-display text-2xl text-paper">Perfect For</h2>
            <ul class="mt-5 space-y-3">
              {
                perfectFor.map((p) => (
                  <li class="flex items-center gap-3 text-smoke">
                    <span aria-hidden="true">{p.emoji}</span> {p.label}
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2 class="font-display text-2xl text-paper">What's Included</h2>
            <ul class="mt-5 space-y-3">
              {
                included.map((item) => (
                  <li class="flex items-start gap-3 text-smoke">
                    <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {item}
                  </li>
                ))
              }
            </ul>
            <p class="mt-4 text-sm text-smoke-dim">
              Menu options can be customized based on your event needs.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="experiences" class="scroll-mt-24 bg-ink py-20 sm:py-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <SectionHeading eyebrow="Pick Your Format" heading="Choose Your Experience" />
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {experiences.map((exp) => <ExperienceCard experience={exp} />)}
        </div>
      </div>
    </section>

    <section class="bg-ink-soft py-20 sm:py-28">
      <div class="mx-auto max-w-3xl px-6 lg:px-10">
        <SectionHeading eyebrow="Simple Process" heading="How It Works" />
        <ol class="grid grid-cols-1 gap-8 sm:grid-cols-3">
          {
            steps.map((s, i) => (
              <li class="text-center">
                <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full border border-gold/40 font-display text-lg text-gold">
                  {i + 1}
                </div>
                <h3 class="mt-4 font-display text-lg text-paper">{s.title}</h3>
                <p class="mt-2 text-sm text-smoke">{s.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bg-ink py-16">
      <div class="mx-auto max-w-2xl px-6 text-center lg:px-10">
        <p class="text-lg text-smoke">
          With creativity, food, and atmosphere all thoughtfully curated, your guests don't just
          attend, they experience something memorable.
        </p>
      </div>
    </section>

    {bookingFaq.length > 0 && (
      <section class="bg-ink py-20 sm:py-28">
        <div class="mx-auto max-w-3xl px-6 lg:px-10">
          <h2 class="mb-8 text-center font-display text-3xl text-paper">Questions</h2>
          <FAQ items={bookingFaq} />
        </div>
      </section>
    )}

    <section id="request" class="scroll-mt-24 bg-ink-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 lg:px-10">
        <div class="mb-10 text-center">
          <h2 class="font-display text-balance text-4xl text-paper sm:text-5xl">
            Ready to Bring This Experience to Your Event?
          </h2>
          <p class="mt-3 text-smoke">Let's create something unforgettable together.</p>
        </div>

        <div class="grid grid-cols-1 overflow-hidden rounded-3xl border border-line lg:grid-cols-2">
          <div class="bg-surface p-8 sm:p-12">
            <form id="booking-form" class="flex flex-col gap-6" novalidate>
              <!-- Honeypot — hidden from real visitors, most simple bots fill it anyway. -->
              <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
                <label for="company">Company</label>
                <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
              </div>

              <p id="step-progress" class="text-xs font-semibold uppercase tracking-[0.2em] text-gold" aria-live="polite">
                Step 1 of 3
              </p>

              <!-- Step 1: the event -->
              <fieldset data-step="1" class="flex flex-col gap-5">
                <legend class="mb-1 font-display text-2xl text-paper">About the event</legend>
                <div>
                  <label for="eventType" class="mb-1.5 block text-sm font-medium text-smoke">Event type</label>
                  <select
                    id="eventType"
                    name="eventType"
                    class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper focus:border-gold focus:outline-none"
                  >
                    {experiences.map((exp) => <option>{exp.name}</option>)}
                    <option>Private / Corporate Booking</option>
                    <option>Other</option>
                  </select>
                </div>
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                  <div>
                    <label for="guests" class="mb-1.5 block text-sm font-medium text-smoke">Number of guests</label>
                    <input
                      id="guests"
                      name="guests"
                      type="number"
                      min="1"
                      class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                      placeholder="e.g. 12"
                    />
                  </div>
                  <div>
                    <label for="date" class="mb-1.5 block text-sm font-medium text-smoke">Preferred date</label>
                    <input
                      id="date"
                      name="date"
                      type="date"
                      class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper focus:border-gold focus:outline-none"
                    />
                  </div>
                </div>
              </fieldset>

              <!-- Step 2: who we contact -->
              <fieldset data-step="2" class="flex flex-col gap-5" hidden>
                <legend class="mb-1 font-display text-2xl text-paper">Your details</legend>
                <div>
                  <label for="name" class="mb-1.5 block text-sm font-medium text-smoke">Name</label>
                  <input
                    id="name"
                    name="name"
                    type="text"
                    required
                    autocomplete="name"
                    class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="mb-1.5 block text-sm font-medium text-smoke">Email</label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                    placeholder="you@email.com"
                  />
                </div>
              </fieldset>

              <!-- Step 3: details and review -->
              <fieldset data-step="3" class="flex flex-col gap-5" hidden>
                <legend class="mb-1 font-display text-2xl text-paper">Anything else?</legend>
                <div>
                  <label for="message" class="mb-1.5 block text-sm font-medium text-smoke">Message</label>
                  <textarea
                    id="message"
                    name="message"
                    rows="4"
                    class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                    placeholder="Vision for the event, theme ideas, anything else we should know"
                  ></textarea>
                </div>
                <div id="review" class="rounded-xl border border-line bg-ink p-5 text-sm text-smoke">
                  <p class="mb-2 font-semibold text-paper">Please check before sending</p>
                  <dl id="review-list" class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1"></dl>
                </div>
              </fieldset>

              <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
                <button
                  type="button"
                  id="step-back"
                  class="inline-flex items-center justify-center rounded-full border border-paper/30 px-6 py-3 text-sm font-semibold text-paper transition-colors hover:border-gold hover:text-gold"
                  hidden
                >
                  Back
                </button>
                <button
                  type="button"
                  id="step-next"
                  class="inline-flex items-center justify-center rounded-full bg-gold px-8 py-3.5 text-sm font-semibold text-ink transition-transform hover:scale-[1.01] sm:ml-auto"
                >
                  Next
                </button>
                <button
                  type="submit"
                  id="step-submit"
                  class="inline-flex items-center justify-center rounded-full bg-gold px-8 py-3.5 text-sm font-semibold text-ink transition-transform hover:scale-[1.01] sm:ml-auto"
                  hidden
                >
                  Submit Booking Request
                </button>
              </div>

              <p id="form-status" class="text-sm text-smoke" role="status" aria-live="polite"></p>
            </form>
          </div>

          <ContactInfoPanel
            heading="Let's create something unforgettable"
            body="Prefer email? Reach out directly and tell us about your event."
          />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById("booking-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const progress = document.getElementById("step-progress");
  const back = document.getElementById("step-back") as HTMLButtonElement | null;
  const next = document.getElementById("step-next") as HTMLButtonElement | null;
  const submitBtn = document.getElementById("step-submit") as HTMLButtonElement | null;
  const reviewList = document.getElementById("review-list");
  const steps = Array.from(form?.querySelectorAll<HTMLFieldSetElement>("fieldset[data-step]") ?? []);
  const totalSteps = steps.length;
  let current = 1;

  const showStep = (n: number) => {
    current = n;
    steps.forEach((s) => (s.hidden = Number(s.dataset.step) !== n));
    if (progress) progress.textContent = `Step ${n} of ${totalSteps}`;
    if (back) back.hidden = n === 1;
    if (next) next.hidden = n === totalSteps;
    if (submitBtn) submitBtn.hidden = n !== totalSteps;
    if (n === totalSteps) renderReview();
    steps[n - 1]?.querySelector<HTMLInputElement>("input, select, textarea")?.focus();
  };

  // Validate only the fields on the current step, reporting errors through
  // the browser's native constraint messages (announced by screen readers).
  const stepValid = (n: number) => {
    const fields = steps[n - 1]?.querySelectorAll<HTMLInputElement>("input, select, textarea") ?? [];
    for (const f of Array.from(fields)) {
      if (!f.checkValidity()) {
        f.reportValidity();
        return false;
      }
    }
    return true;
  };

  const renderReview = () => {
    if (!form || !reviewList) return;
    const data = new FormData(form);
    const rows: [string, string][] = [
      ["Event", String(data.get("eventType") || "—")],
      ["Guests", String(data.get("guests") || "—")],
      ["Date", String(data.get("date") || "—")],
      ["Name", String(data.get("name") || "—")],
      ["Email", String(data.get("email") || "—")],
    ];
    reviewList.innerHTML = rows
      .map(([k, v]) => `<dt class="text-smoke-dim">${k}</dt><dd class="text-paper">${v.replace(/[&<>"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"} as Record<string,string>)[c])}</dd>`)
      .join("");
  };

  next?.addEventListener("click", () => {
    if (stepValid(current)) showStep(current + 1);
  });
  back?.addEventListener("click", () => showStep(current - 1));

  if (form && steps.length) showStep(1);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;
    // Enter on an earlier step advances rather than sending a partial form.
    if (current < totalSteps) {
      if (stepValid(current)) showStep(current + 1);
      return;
    }
    if (!stepValid(current)) return;

    status.textContent = "Sending…";

    try {
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error("Request failed");

      status.textContent = "Thank you — we'll be in touch shortly.";
      form.reset();
    } catch {
      status.textContent = "Something went wrong. Please email us directly instead.";
    }
  });
</script>
