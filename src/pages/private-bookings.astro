---
// VERIFIED (AUDIT.md §4) — verbatim from the live /private-bookings page
// unless noted. Pricing, capacity, turnaround times, and guarantees are
// deliberately absent — none were confirmed by the audit.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import ExperienceCard from "../components/ui/ExperienceCard.astro";
import ContactInfoPanel from "../components/ui/ContactInfoPanel.astro";
import { experiences } from "../data/experiences";

const perfectFor = [
  { emoji: "🎉", label: "Birthdays & Celebrations" },
  { emoji: "💼", label: "Corporate Teams" },
  { emoji: "🤝", label: "Community Groups" },
  { emoji: "👨‍👩‍👧", label: "Families & Youth" },
];

const included = [
  "Guided paint experience (no experience needed)",
  "All materials provided",
  "Curated meal included",
  "Custom theme options",
  "Setup and facilitation",
  "Engaging and welcoming atmosphere",
];

const steps = [
  { title: "Submit Your Request", body: "Tell us about your event, group size, and preferred date." },
  { title: "Customize Your Experience", body: "We tailor the experience, including theme and food options." },
  { title: "Show Up & Enjoy", body: "We handle everything so you can focus on the experience." },
];
---

<Layout
  title="Private Bookings — Creative Dynasty Events"
  description="A fully guided creative experience paired with a flavorful meal, designed to bring people together in a meaningful and memorable way."
>
  <Header />
  <main>
    <PageHero
      eyebrow="Private Bookings"
      title="Book a Private Paint, Dine & Connect Experience"
      subtitle="A fully guided creative experience paired with a flavorful meal, designed to bring people together in a meaningful and memorable way."
    />

    <section class="bg-ink py-20 sm:py-28">
      <div class="mx-auto max-w-3xl px-6 text-center lg:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">More Than an Event</p>
        <p class="mt-5 text-lg text-smoke">
          Creative Dynasty experiences are designed to go beyond traditional paint events. Each
          experience blends creativity, food, and connection to create an atmosphere that feels
          engaging, social, and complete.
        </p>
      </div>
    </section>

    <section class="bg-ink-soft py-20 sm:py-28">
      <div class="mx-auto max-w-5xl px-6 lg:px-10">
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
          <div>
            <h2 class="font-display text-2xl text-paper">Perfect For</h2>
            <ul class="mt-5 space-y-3">
              {
                perfectFor.map((p) => (
                  <li class="flex items-center gap-3 text-smoke">
                    <span aria-hidden="true">{p.emoji}</span> {p.label}
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2 class="font-display text-2xl text-paper">What's Included</h2>
            <ul class="mt-5 space-y-3">
              {
                included.map((item) => (
                  <li class="flex items-start gap-3 text-smoke">
                    <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    {item}
                  </li>
                ))
              }
            </ul>
            <p class="mt-4 text-sm text-smoke-dim">
              Menu options can be customized based on your event needs.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="experiences" class="scroll-mt-24 bg-ink py-20 sm:py-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <SectionHeading eyebrow="Pick Your Format" heading="Choose Your Experience" />
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {experiences.map((exp) => <ExperienceCard experience={exp} />)}
        </div>
      </div>
    </section>

    <section class="bg-ink-soft py-20 sm:py-28">
      <div class="mx-auto max-w-3xl px-6 lg:px-10">
        <SectionHeading eyebrow="Simple Process" heading="How It Works" />
        <ol class="grid grid-cols-1 gap-8 sm:grid-cols-3">
          {
            steps.map((s, i) => (
              <li class="text-center">
                <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full border border-gold/40 font-display text-lg text-gold">
                  {i + 1}
                </div>
                <h3 class="mt-4 font-display text-lg text-paper">{s.title}</h3>
                <p class="mt-2 text-sm text-smoke">{s.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bg-ink py-16">
      <div class="mx-auto max-w-2xl px-6 text-center lg:px-10">
        <p class="text-lg text-smoke">
          With creativity, food, and atmosphere all thoughtfully curated, your guests don't just
          attend, they experience something memorable.
        </p>
      </div>
    </section>

    <section id="request" class="scroll-mt-24 bg-ink-soft py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-6 lg:px-10">
        <div class="mb-10 text-center">
          <h2 class="font-display text-balance text-4xl text-paper sm:text-5xl">
            Ready to Bring This Experience to Your Event?
          </h2>
          <p class="mt-3 text-smoke">Let's create something unforgettable together.</p>
        </div>

        <div class="grid grid-cols-1 overflow-hidden rounded-3xl border border-line lg:grid-cols-2">
          <div class="bg-surface p-8 sm:p-12">
            <form id="booking-form" class="flex flex-col gap-5" novalidate>
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-1.5 block text-sm font-medium text-smoke">Name</label>
                  <input
                    id="name"
                    name="name"
                    type="text"
                    required
                    class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="mb-1.5 block text-sm font-medium text-smoke">Email</label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                    placeholder="you@email.com"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                  <label for="eventType" class="mb-1.5 block text-sm font-medium text-smoke">Event type</label>
                  <select
                    id="eventType"
                    name="eventType"
                    class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper focus:border-gold focus:outline-none"
                  >
                    {experiences.map((exp) => <option>{exp.name}</option>)}
                    <option>Private / Corporate Booking</option>
                    <option>Other</option>
                  </select>
                </div>
                <div>
                  <label for="guests" class="mb-1.5 block text-sm font-medium text-smoke">Number of guests</label>
                  <input
                    id="guests"
                    name="guests"
                    type="number"
                    min="1"
                    class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                    placeholder="e.g. 12"
                  />
                </div>
              </div>

              <div>
                <label for="date" class="mb-1.5 block text-sm font-medium text-smoke">Preferred date</label>
                <input
                  id="date"
                  name="date"
                  type="date"
                  class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper focus:border-gold focus:outline-none"
                />
              </div>

              <div>
                <label for="message" class="mb-1.5 block text-sm font-medium text-smoke">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                  placeholder="Vision for the event, theme ideas, anything else we should know"
                ></textarea>
              </div>

              <button
                type="submit"
                class="mt-2 inline-flex items-center justify-center rounded-full bg-gold px-8 py-3.5 text-sm font-semibold text-ink transition-transform hover:scale-[1.01]"
              >
                Submit Booking Request
              </button>

              <p id="form-status" class="text-sm text-smoke" role="status" aria-live="polite"></p>
            </form>
          </div>

          <ContactInfoPanel
            heading="Let's create something unforgettable"
            body="Prefer email? Reach out directly and tell us about your event."
          />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById("booking-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;

    status.textContent = "Sending…";

    try {
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error("Request failed");

      status.textContent = "Thank you — we'll be in touch shortly.";
      form.reset();
    } catch {
      status.textContent = "Something went wrong. Please email us directly instead.";
    }
  });
</script>
