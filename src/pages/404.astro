---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/ui/Button.astro";
---

<Layout title="Page Not Found — Creative Dynasty Events" description="This page doesn't exist.">
  <Header />
  <main>
    <section class="flex min-h-[70vh] items-center bg-ink py-28">
      <div class="mx-auto max-w-lg px-6 text-center lg:px-10">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">404</p>
        <h1 class="mt-3 font-display text-balance text-4xl text-paper sm:text-5xl">
          We couldn't find that page
        </h1>
        <p class="mx-auto mt-4 max-w-sm text-smoke">
          The page you're looking for may have moved. Try one of these instead.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href="/" variant="primary">Back to Home</Button>
          <Button href="/events" variant="secondary">Browse Events</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
