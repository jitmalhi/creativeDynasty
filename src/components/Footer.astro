---
const year = new Date().getFullYear();

const links = [
  { label: "About", href: "/about" },
  { label: "Events", href: "/events" },
  { label: "Private Bookings", href: "/private-bookings" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="bg-deep-slate py-14">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-8 px-6 text-center lg:px-10">
    <a href="/" aria-label="Creative Dynasty Events — home">
      <img
        src="/images/logo-full-on-dark.svg"
        alt="Creative Dynasty Events"
        width="380"
        height="330"
        class="h-auto w-56 sm:w-64"
        loading="lazy"
      />
    </a>

    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      {
        links.map((link) => (
          <a href={link.href} class="text-sm text-white/80 transition-colors hover:text-peach">
            {link.label}
          </a>
        ))
      }
      <a
        href="https://www.instagram.com/creative_dynasty_events/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-white/80 transition-colors hover:text-peach"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
        Instagram
      </a>
    </nav>

    <p class="text-sm text-white/60">
      &copy; {year} Creative Dynasty Events. All rights reserved.
    </p>
  </div>
</footer>
