    <p class="font-display text-paper">
      Creative Dynasty <span class="text-gold">Events</span>
    </p>
    <p class="text-sm text-smoke-dim">
      &copy; {year} Creative Dynasty Events. All rights reserved.
    </p>
  </div>
</footer>
