---
const year = new Date().getFullYear();

const links = [
  { label: "About", href: "/about" },
  { label: "Events", href: "/events" },
  { label: "Private Bookings", href: "/private-bookings" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="border-t border-line bg-ink py-12">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-6 text-center lg:flex-row lg:justify-between lg:px-10 lg:text-left">
    <a href="/" class="flex items-center gap-2.5 font-display text-paper">
      <img src="/images/logo-emblem.svg" alt="" width="40" height="43" class="h-10 w-auto" />
      <span>Creative Dynasty <span class="text-terracotta">Events</span></span>
    </a>

    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      {
        links.map((link) => (
          <a href={link.href} class="text-sm text-smoke transition-colors hover:text-terracotta">
            {link.label}
          </a>
        ))
      }
      <a
        href="https://www.instagram.com/creative_dynasty_events/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-smoke transition-colors hover:text-terracotta"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
        Instagram
      </a>
    </nav>

    <p class="text-sm text-smoke-dim">
      &copy; {year} Creative Dynasty Events. All rights reserved.
    </p>
  </div>
</footer>
