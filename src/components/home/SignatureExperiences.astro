---
import { experiences } from "../../data/experiences";
import SectionHeading from "../ui/SectionHeading.astro";
import ExperienceCard from "../ui/ExperienceCard.astro";
import Button from "../ui/Button.astro";
---

<section id="experiences" class="scroll-mt-24 bg-ink-soft py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <SectionHeading eyebrow="What We Offer" heading="Our Signature Experiences" />

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {experiences.map((exp) => <ExperienceCard experience={exp} />)}
    </div>

    <div class="mt-12 text-center">
      <Button href="/events" variant="ghost">View All Events</Button>
    </div>
  </div>
</section>
