---
interface Props {
  eyebrow: string;
  heading: string;
  subtext?: string;
  align?: "center" | "left";
}

const { eyebrow, heading, subtext, align = "center" } = Astro.props;
const alignClass = align === "center" ? "mx-auto text-center" : "text-left";
---

<div class={`mb-14 max-w-2xl ${alignClass}`}>
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-terracotta">{eyebrow}</p>
  <h2 class="mt-3 font-display text-balance text-4xl text-paper sm:text-5xl">{heading}</h2>
  {subtext && <p class="mt-4 text-smoke">{subtext}</p>}
</div>
