---
// CONTACT INFO — see src/components/Contact.astro removal note / HANDOFF.md
// Owner requirements #1–#2 for the full classification of each item below.
const contactEmail = "creativedynastevents3@gmail.com"; // OWNER CONFIRMATION REQUIRED (spelling)
const instagramHref = "https://www.instagram.com/creative_dynasty_events/"; // confirmed by project team 2026-10-29
// No phone or address is shown: none exist on the live site (AUDIT.md).
// No Facebook or TikTok is shown: no verified URL exists for either.

interface Props {
  heading: string;
  body: string;
}

const { heading, body } = Astro.props;
---

<div class="relative flex flex-col justify-between bg-deep-slate p-8 sm:p-12">
  <div>
    <h3 class="font-display text-2xl text-white">{heading}</h3>
    <p class="mt-3 max-w-sm text-peach">{body}</p>
  </div>

  <div class="mt-10 space-y-4">
    <a href={`mailto:${contactEmail}`} class="block text-white hover:text-peach">
      {contactEmail}
    </a>

    <div class="pt-2">
      <a
        href={instagramHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-medium text-white/80 hover:text-peach"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
        <span class="underline decoration-peach/50 underline-offset-4">Instagram</span>
      </a>
    </div>
  </div>
</div>
