---
import type { Testimonial } from "../../data/testimonials";

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<figure class="rounded-3xl border border-line bg-surface p-8">
  <blockquote class="font-display text-lg text-paper">"{testimonial.quote}"</blockquote>
  {testimonial.name && (
    <figcaption class="mt-4 text-sm font-medium text-gold">— {testimonial.name}</figcaption>
  )}
</figure>
