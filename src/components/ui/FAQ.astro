---
// Zero-JS accessible accordion using native <details>/<summary> — keyboard
// and screen-reader accessible by default, no interaction JS needed.
interface Item {
  question: string;
  answer: string;
};

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {
    items.map((item) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg text-paper marker:content-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold">
          {item.question}
          <span class="shrink-0 text-gold transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 text-smoke">{item.answer}</p>
      </details>
    ))
  }
</div>
