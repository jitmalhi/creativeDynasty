---
// TODO: Confirm exact award wording and add real partner/press logos to /public/images/press/
const partners = ["Local Press", "Partner Studio", "Featured In", "Community Partner"];
---

<section class="border-y border-line bg-ink-soft py-6">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-6 px-6 lg:flex-row lg:justify-between lg:px-10">
    <p class="text-center text-sm font-medium text-paper lg:text-left">
      <span class="text-gold">Nominated</span> — 2026 Visual Arts Award, The Lotus Hope Foundation
    </p>

    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 opacity-60">
      {
        partners.map((name) => (
          <span class="text-xs font-semibold uppercase tracking-widest text-smoke">{name}</span>
        ))
      }
    </div>
  </div>
</section>
