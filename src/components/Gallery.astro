---
// Checkpoint 5: reworked from a uniform 3-column masonry grid (Checkpoint
// 4's "most visually inert section" finding, and the only section on the
// site using a filterable card-directory pattern) into an intentional
// editorial arrangement — one full-width feature image plus a smaller
// supporting grid, varied proportions instead of six identical tiles.
//
// The category filter buttons/JS from the previous version were removed
// as part of this change, not preserved alongside it: an asymmetric
// feature-plus-supporting layout and a dynamically-filterable grid pull
// in opposite directions (filtering the feature image away would leave a
// dead gap where the layout's whole composition depends on it being
// there). A curated, editorial mosaic doesn't need interactive filtering
// to feel premium — most high-end portfolio sections don't have one — and
// dropping it is also less JavaScript for six placeholder images, which
// fits this checkpoint's technical-discipline instruction. Categories are
// still real data (see src/data/gallery.ts) and remain in each image's
// alt text; only the interactive filter UI was removed.
import { gallery } from "../data/gallery";

const [feature, ...supporting] = gallery;
---

<section id="gallery" class="bg-ink-soft py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Curated Portfolio</p>
      <h2 class="mt-3 font-display text-balance text-4xl text-paper sm:text-5xl">
        Moments from past gatherings
      </h2>
      <p class="mt-4 text-smoke">
        A look at the creativity, connection, and community every Creative Dynasty experience is
        built around.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4">
      {feature && (
        <figure class="overflow-hidden rounded-2xl border border-line bg-surface">
          <div class="aspect-[16/9] sm:aspect-[21/9]">
            <img
              src={feature.src}
              alt={feature.alt}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
            />
          </div>
        </figure>
      )}

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        {supporting.map((item) => (
          <figure class="overflow-hidden rounded-2xl border border-line bg-surface">
            <div class="aspect-[4/5]">
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
              />
            </div>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
