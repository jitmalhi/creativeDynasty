---
import { gallery, galleryCategories } from "../data/gallery";
---

<section id="gallery" class="bg-ink-soft py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Curated Portfolio</p>
      <h2 class="mt-3 font-display text-balance text-4xl text-paper sm:text-5xl">
        Moments from past gatherings
      </h2>
    </div>

    <div class="mb-10 flex flex-wrap justify-center gap-2" id="gallery-filters">
      {
        galleryCategories.map((cat, i) => (
          <button
            type="button"
            data-filter={cat}
            aria-pressed={i === 0 ? "true" : "false"}
            class="filter-btn rounded-full border border-line px-5 py-2 text-sm font-medium text-smoke transition-colors hover:border-gold hover:text-gold data-[active=true]:border-gold data-[active=true]:bg-gold data-[active=true]:text-ink"
            data-active={i === 0 ? "true" : "false"}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <div id="gallery-grid" class="columns-1 gap-5 sm:columns-2 lg:columns-3">
      {
        gallery.map((item) => (
          <figure
            class="gallery-item mb-5 break-inside-avoid overflow-hidden rounded-2xl border border-line bg-surface"
            data-category={item.category}
          >
            <div class="overflow-hidden">
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                class="h-full w-full scale-100 object-cover transition-transform duration-500 hover:scale-105"
              />
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const items = document.querySelectorAll<HTMLElement>(".gallery-item");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;

      buttons.forEach((b) => {
        b.dataset.active = "false";
        b.setAttribute("aria-pressed", "false");
      });
      btn.dataset.active = "true";
      btn.setAttribute("aria-pressed", "true");

      items.forEach((item) => {
        const show = filter === "All" || item.dataset.category === filter;
        item.classList.toggle("hidden", !show);
      });
    });
  });
</script>
