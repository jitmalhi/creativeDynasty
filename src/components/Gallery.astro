---
// Editorial photography layout (premium visual refinement pass).
//
// Structure, top to bottom:
//   1. One full-width landscape feature image.
//   2. Five supporting images in an asymmetric 12-column grid on desktop,
//      a calm two-column grid on mobile. Varied proportions, one column
//      offset, no captions.
//
// The category filter was removed earlier (Checkpoint 5) because it
// conflicted with an asymmetric feature composition. Nothing here is
// interactive, so there is no gallery JavaScript.
import { gallery } from "../data/gallery";

const [feature, ...supporting] = gallery;

// Per-position layout. Mobile: a full-width feature, then pairs of halves,
// then a full-width close. Desktop: wide + narrow, then three equal columns,
// with the narrow column offset to break the rhythm.
const supportingLayout = [
  "col-span-2 md:col-span-7 aspect-[3/2]",
  "col-span-1 md:col-span-5 md:mt-16 aspect-[4/5]",
  "col-span-1 md:col-span-4 aspect-[4/5]",
  "col-span-1 md:col-span-4 aspect-[4/5]",
  "col-span-2 md:col-span-4 aspect-[4/5]",
];
---

<section id="gallery" class="bg-ink-soft py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal mx-auto mb-12 max-w-2xl text-center sm:mb-16">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-terracotta">Curated Portfolio</p>
      <h2 class="mt-3 font-display text-balance text-4xl text-paper sm:text-5xl">
        Moments from past gatherings
      </h2>
      <p class="mt-4 text-smoke">
        A look at the creativity, connection, and community every Creative Dynasty experience is
        built around.
      </p>
    </div>

    {feature && (
      <figure class="reveal overflow-hidden rounded-md">
        <img
          src={feature.src}
          alt={feature.alt}
          loading="lazy"
          class="aspect-[3/2] w-full object-cover md:aspect-[16/9]"
        />
      </figure>
    )}

    <div class="mt-4 grid grid-cols-2 gap-4 sm:mt-6 sm:gap-6 md:grid-cols-12">
      {supporting.map((item, i) => (
        <figure class={`reveal overflow-hidden rounded-md ${supportingLayout[i] ?? "col-span-1 md:col-span-4 aspect-[4/5]"}`}>
          <img
            src={item.src}
            alt={item.alt}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
