---
import { events } from "../data/events";
---

<section id="events" class="bg-ink py-24 sm:py-32">
  <div class="mx-auto max-w-5xl px-6 lg:px-10">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Upcoming Events</p>
      <h2 class="mt-3 font-display text-balance text-4xl text-paper sm:text-5xl">
        Reserve your seat at the table
      </h2>
    </div>

    <div class="flex flex-col divide-y divide-line border-y border-line">
      {
        events.map((event) => (
          <div class="flex flex-col gap-4 py-7 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6">
              <span class="w-40 shrink-0 text-sm font-medium text-gold">{event.date}</span>
              <div>
                <h3 class="font-display text-xl text-paper">{event.title}</h3>
                <p class="mt-1 max-w-lg text-sm text-smoke">{event.description}</p>
              </div>
            </div>
            <a
              href={event.href}
              class="inline-flex shrink-0 items-center justify-center rounded-full border border-gold/60 px-6 py-2.5 text-sm font-semibold text-gold transition-colors hover:bg-gold hover:text-ink"
            >
              Reserve Your Seat
            </a>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center text-sm text-smoke-dim">
      Want a full calendar and instant checkout? Connect Eventbrite or your ticketing provider
      here.
    </p>
  </div>
</section>
