---
import { events, type EventStatus } from "../data/events";

const statusLabel: Record<EventStatus, string> = {
  "coming-soon": "Coming Soon",
  "registration-open": "Registration Open",
  "registration-closed": "Registration Closed",
  "event-complete": "Event Complete",
};

const statusClass: Record<EventStatus, string> = {
  "coming-soon": "border-terracotta/40 text-teal",
  "registration-open": "border-terracotta bg-deep text-white",
  "registration-closed": "border-line text-smoke-dim",
  "event-complete": "border-line text-smoke-dim",
};
---

<section id="events" class="bg-ink py-24 sm:py-32">
  <div class="mx-auto max-w-5xl px-6 lg:px-10">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-terracotta">Upcoming Events</p>
      <h2 class="mt-3 font-display text-balance text-4xl text-paper sm:text-5xl">
        {events.length > 0 ? "Reserve your seat at the table" : "No public events scheduled right now"}
      </h2>
      {events.length === 0 && (
        <p class="mt-4 text-smoke">
          Public events are announced here as soon as they're scheduled — in the meantime, every
          experience is available to book privately, any time.
        </p>
      )}
    </div>

    {
      events.length === 0 ? (
        <div class="mx-auto flex max-w-md flex-col items-center gap-5 rounded-3xl border border-line bg-surface px-8 py-12 text-center">
          <p class="text-smoke">
            We don't have a public event on the calendar at the moment. Check back soon, or
            plan a private experience for your own group below.
          </p>
          <a
            href="/private-bookings#request"
            class="inline-flex items-center justify-center rounded-full border border-terracotta/60 px-6 py-2.5 text-sm font-semibold text-terracotta transition-colors hover:bg-terracotta hover:text-white"
          >
            Book a Private Experience
          </a>
        </div>
      ) : (
        <div class="flex flex-col divide-y divide-line border-y border-line">
          {events.map((event) => (
            <div class="flex flex-col gap-4 py-7 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6">
                <span class="w-40 shrink-0 text-sm font-medium text-terracotta">{event.date}</span>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-display text-xl text-paper">{event.title}</h3>
                    <span class={`rounded-full border px-2.5 py-0.5 text-xs font-semibold ${statusClass[event.status]}`}>
                      {statusLabel[event.status]}
                    </span>
                  </div>
                  <p class="mt-1 max-w-lg text-sm text-smoke">{event.description}</p>
                  {(event.location || event.price) && (
                    <p class="mt-1 text-xs text-smoke-dim">
                      {[event.location, event.price].filter(Boolean).join(" · ")}
                    </p>
                  )}
                </div>
              </div>
              {event.status === "registration-open" && event.registrationHref ? (
                <a
                  href={event.registrationHref}
                  class="inline-flex shrink-0 items-center justify-center rounded-full border border-terracotta/60 px-6 py-2.5 text-sm font-semibold text-terracotta transition-colors hover:bg-terracotta hover:text-white"
                >
                  Reserve Your Seat
                </a>
              ) : (
                <span class="inline-flex shrink-0 items-center justify-center rounded-full border border-line px-6 py-2.5 text-sm font-semibold text-smoke-dim">
                  {statusLabel[event.status]}
                </span>
              )}
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
