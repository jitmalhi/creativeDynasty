---
---

<section id="top" class="relative flex min-h-screen items-center overflow-hidden bg-ink">
  <!--
    TODO: Replace the placeholder background with a full-width cinematic video loop
    (event lighting, guests painting/mingling) or a slow-motion photo sequence.
    Drop an .mp4 into /public/video/hero.mp4 and swap the <img> below for a <video>
    with autoplay muted loop playsinline poster="/images/hero-placeholder.svg".
  -->
  <img
    src="/images/hero-placeholder.svg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    aria-hidden="true"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/30"></div>
  <div class="relative bg-grain">
    <div class="absolute inset-0" aria-hidden="true"></div>
  </div>

  <div class="relative mx-auto max-w-4xl px-6 pt-24 text-center lg:px-10">
    <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-gold/40 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.2em] text-gold">
      Where Creativity Meets Community
    </p>

    <h1 class="font-display text-balance text-5xl leading-[1.05] text-paper sm:text-6xl lg:text-7xl">
      Immersive Gatherings.
      <br />
      <span class="text-gold-soft">Elevated Culture.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-balance text-lg text-smoke">
      Curated Sip &amp; Paint nights, private socials, and galas that bring art, music, food,
      and community together in one unforgettable evening.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="#events"
        class="w-full rounded-full bg-gold px-8 py-3.5 text-sm font-semibold text-ink transition-transform hover:scale-[1.02] sm:w-auto"
      >
        Explore Upcoming Events
      </a>
      <a
        href="#contact"
        class="w-full rounded-full border border-paper/30 px-8 py-3.5 text-sm font-semibold text-paper transition-colors hover:border-gold hover:text-gold sm:w-auto"
      >
        Book a Consultation
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce text-smoke-dim">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
