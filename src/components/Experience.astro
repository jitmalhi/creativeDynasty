---
const experiences = ["After Dark Experience", "Little Creators Experience", "The Collective Experience"];
---

<section id="experience" class="bg-ink py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">The Experience</p>
      <h2 class="mt-3 font-display text-balance text-4xl text-paper sm:text-5xl">
        More than an event. A full sensory evening.
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3 lg:grid-rows-2">
      <!-- Card 1: large feature -->
      <div class="group relative flex flex-col justify-end overflow-hidden rounded-3xl border border-line bg-surface p-8 lg:col-span-2 lg:row-span-2 lg:p-12">
        <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-wine/30 blur-3xl transition-transform duration-700 group-hover:scale-110"></div>
        <div class="relative">
          <h3 class="font-display text-3xl text-paper sm:text-4xl">Beyond the Canvas</h3>
          <p class="mt-4 max-w-md text-smoke">
            Every booking is a complete sensory package — atmosphere, live music, and curated
            dining, designed around a guided creative moment.
          </p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {
              experiences.map((name) => (
                <li class="rounded-full border border-gold/30 px-3 py-1 text-xs font-medium text-gold-soft">
                  {name}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Card 2: Art & Connection -->
      <div class="group relative overflow-hidden rounded-3xl border border-line bg-surface p-8">
        <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-gold/20 blur-3xl transition-transform duration-700 group-hover:scale-110"></div>
        <div class="relative">
          <h3 class="font-display text-2xl text-paper">Art &amp; Connection</h3>
          <p class="mt-3 text-smoke">
            Rooted in visual arts and community building — every gathering is designed to bring
            people together through shared creativity.
          </p>
        </div>
      </div>

      <!-- Card 3: Private & Corporate Bookings -->
      <div class="group relative overflow-hidden rounded-3xl border border-gold/30 bg-gradient-to-br from-wine/40 to-surface p-8">
        <div class="relative">
          <h3 class="font-display text-2xl text-paper">Private &amp; Corporate Bookings</h3>
          <p class="mt-3 text-smoke">
            Custom experiences for teams, celebrations, and private parties — tailored end to
            end.
          </p>
          <a
            href="#contact"
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-gold hover:text-gold-soft"
          >
            Inquire now
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
