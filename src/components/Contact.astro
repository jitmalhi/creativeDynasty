---
// CONTACT INFO — reconciled against AUDIT.md (2026-09-28):
//
// Email — OWNER CONFIRMATION REQUIRED. Found via a verified, working
// mailto: link on the live Contact page (AUDIT.md §4), but the spelling
// ("creativedynastEvents3", no "y") is unusual enough to double-check
// before this is treated as final. Kept here (not blanked) because it is
// a real, functioning address found on the business's own site, not an
// invented one.
const contactEmail = "creativedynastevents3@gmail.com";

// Phone — UNSUPPORTED/FABRICATED CONTENT REMOVED. The pre-audit build
// showed a placeholder "(555) 010-0100". AUDIT.md found no phone number
// anywhere on the live site. Not displayed until the owner supplies a real
// one — see HANDOFF.md, Owner requirements #1.
// const contactPhone = "[CONTENT REQUIRED FROM CREATIVE DYNASTY EVENTS]";

// Social — Facebook and TikTok UNSUPPORTED/FABRICATED CONTENT REMOVED.
// AUDIT.md confirmed the live site's Facebook icon actually points to
// Wix's own corporate page (facebook.com/wix), not the business's — so
// there is no verified Facebook URL to use here either. No TikTok was
// found anywhere. Instagram is OWNER CONFIRMATION REQUIRED: the handle
// below was found on the live site's Contact page but is not yet
// confirmed as current/owner-controlled (HANDOFF.md, Owner requirements
// #2) — shown with a visible "pending confirmation" note rather than
// presented as verified.
const socials = [
  { label: "Instagram", href: "https://www.instagram.com/creative_dynasty_events", confirmed: false },
];
---

<section id="contact" class="bg-ink-soft py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid grid-cols-1 overflow-hidden rounded-3xl border border-line lg:grid-cols-2">
      <!-- Form side -->
      <div class="bg-surface p-8 sm:p-12">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Private Booking</p>
        <h2 class="mt-3 font-display text-balance text-3xl text-paper sm:text-4xl">
          Tell us about your event
        </h2>

        <form id="contact-form" class="mt-8 flex flex-col gap-5" novalidate>
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-smoke">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-smoke">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                placeholder="you@email.com"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="eventType" class="mb-1.5 block text-sm font-medium text-smoke">Event type</label>
              <select
                id="eventType"
                name="eventType"
                class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper focus:border-gold focus:outline-none"
              >
                <option>After Dark Experience</option>
                <option>Little Creators Experience</option>
                <option>The Collective Experience</option>
                <option>Private / Corporate Booking</option>
                <option>Other</option>
              </select>
            </div>
            <div>
              <label for="guests" class="mb-1.5 block text-sm font-medium text-smoke">Number of guests</label>
              <input
                id="guests"
                name="guests"
                type="number"
                min="1"
                class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
                placeholder="e.g. 12"
              />
            </div>
          </div>

          <div>
            <label for="date" class="mb-1.5 block text-sm font-medium text-smoke">Preferred date</label>
            <input
              id="date"
              name="date"
              type="date"
              class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper focus:border-gold focus:outline-none"
            />
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-smoke">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full rounded-xl border border-line bg-ink px-4 py-3 text-paper placeholder:text-smoke-dim focus:border-gold focus:outline-none"
              placeholder="Guest count, vision for the evening, anything else we should know"
            ></textarea>
          </div>

          <button
            type="submit"
            class="mt-2 inline-flex items-center justify-center rounded-full bg-gold px-8 py-3.5 text-sm font-semibold text-ink transition-transform hover:scale-[1.01]"
          >
            Send Inquiry
          </button>

          <p id="form-status" class="text-sm text-smoke" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- Info side -->
      <div class="relative flex flex-col justify-between bg-gradient-to-br from-wine to-ink p-8 sm:p-12">
        <div>
          <h3 class="font-display text-2xl text-paper">Let's create something unforgettable</h3>
          <p class="mt-3 max-w-sm text-paper/80">
            Whether it's an intimate gathering or a fully private experience, we'll help you
            bring it to life.
          </p>
        </div>

        <div class="mt-10 space-y-4">
          <a href={`mailto:${contactEmail}`} class="block text-paper/90 hover:text-gold-soft">
            {contactEmail}
          </a>

          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pt-2">
            {
              socials.map((s) => (
                <span class="flex items-center gap-1.5">
                  <a
                    href={s.href}
                    class="text-sm font-medium text-paper/70 underline decoration-gold/40 underline-offset-4 hover:text-gold-soft"
                  >
                    {s.label}
                  </a>
                  {!s.confirmed && (
                    <span class="text-xs text-smoke-dim">(pending confirmation)</span>
                  )}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;

    status.textContent = "Sending…";

    try {
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error("Request failed");

      status.textContent = "Thank you — we'll be in touch shortly.";
      form.reset();
    } catch {
      status.textContent = "Something went wrong. Please email us directly instead.";
    }
  });
</script>
