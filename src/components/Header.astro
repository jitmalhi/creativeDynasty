---
import { experiences } from "../data/experiences";

const { onDark = false } = Astro.props;

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Events", href: "/events" },
  { label: "Private Bookings", href: "/private-bookings" },
  { label: "Contact", href: "/contact" },
];
---

<header
  id="site-header"
  class:list={["fixed inset-x-0 top-0 z-50 transition-colors duration-300", onDark && "header-dark"]}
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
    <a href="/" class="hdr-brand font-display text-base tracking-wide text-paper sm:text-lg">
      Creative Dynasty <span class="hdr-accent text-terracotta">Events</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      <div class="group relative">
        <a href="/#experiences" class="hdr-link flex items-center gap-1 text-sm font-medium text-smoke transition-colors hover:text-terracotta">
          Experiences
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <div class="invisible absolute left-1/2 top-full z-10 w-64 -translate-x-1/2 pt-3 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="flex flex-col gap-1 rounded-2xl border border-line bg-surface p-2 shadow-lg">
            {
              experiences.map((exp) => (
                <a
                  href={`/experiences/${exp.slug}`}
                  class="rounded-xl px-3 py-2.5 text-sm font-medium text-smoke transition-colors hover:bg-ink-soft hover:text-terracotta"
                >
                  {exp.emoji} {exp.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="hdr-link text-sm font-medium text-smoke transition-colors hover:text-terracotta"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/private-bookings"
      class="hdr-cta hidden rounded-full border border-terracotta/60 px-5 py-2 text-sm font-medium text-terracotta transition-colors hover:bg-terracotta hover:text-white md:inline-block"
    >
      Book a Consultation
    </a>

    <button
      id="menu-toggle"
      class="hdr-toggle inline-flex h-11 w-11 items-center justify-center rounded-full border border-line text-paper md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-line bg-ink/95 px-6 py-4 backdrop-blur md:hidden"
  >
    <p class="px-3 pt-2 text-xs font-semibold uppercase tracking-widest text-smoke-dim">Experiences</p>
    {
      experiences.map((exp) => (
        <a
          href={`/experiences/${exp.slug}`}
          class="rounded-lg px-3 py-2.5 text-sm font-medium text-smoke transition-colors hover:bg-surface hover:text-terracotta"
        >
          {exp.emoji} {exp.name}
        </a>
      ))
    }
    <div class="my-1 border-t border-line" />
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-3 py-3 text-sm font-medium text-smoke transition-colors hover:bg-surface hover:text-terracotta"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="/private-bookings"
      class="mt-2 rounded-full bg-deep px-5 py-3 text-center text-sm font-semibold text-white"
    >
      Book a Consultation
    </a>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 16 ? "true" : "false";
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("flex");
    menu?.classList.toggle("hidden", isOpen);
    menu?.classList.toggle("flex", !isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    })
  );
</script>

<style>
  /* Over a dark hero photo (home page only), the header at the top of the page
     needs light text. Once scrolled, it sits on the ivory background and uses
     the normal colours. */
  #site-header.header-dark[data-scrolled="false"] .hdr-brand,
  #site-header.header-dark[data-scrolled="false"] .hdr-link { color: #ffffff; }
  #site-header.header-dark[data-scrolled="false"] .hdr-accent { color: #f3c3a0; }
  #site-header.header-dark[data-scrolled="false"] .hdr-cta { color: #ffffff; border-color: rgba(255,255,255,0.6); }
  #site-header.header-dark[data-scrolled="false"] .hdr-toggle { color: #ffffff; border-color: rgba(255,255,255,0.4); }
  #site-header[data-scrolled="true"] {
    background-color: color-mix(in srgb, var(--color-ink) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
</style>
