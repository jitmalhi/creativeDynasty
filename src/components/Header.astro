---
const navLinks = [
  { label: "Experience", href: "#experience" },
  { label: "Gallery", href: "#gallery" },
  { label: "Events", href: "#events" },
  { label: "Private Bookings", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
    <a href="#top" class="font-display text-lg tracking-wide text-paper">
      Creative Dynasty <span class="text-gold">Events</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-smoke transition-colors hover:text-gold"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="hidden rounded-full border border-gold/60 px-5 py-2 text-sm font-medium text-gold transition-colors hover:bg-gold hover:text-ink md:inline-block"
    >
      Book a Consultation
    </a>

    <button
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-full border border-line p-2 text-paper md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-line bg-ink/95 px-6 py-4 backdrop-blur md:hidden"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-3 py-3 text-sm font-medium text-smoke transition-colors hover:bg-surface hover:text-gold"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="#contact"
      class="mt-2 rounded-full bg-gold px-5 py-3 text-center text-sm font-semibold text-ink"
    >
      Book a Consultation
    </a>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    header.dataset.scrolled = window.scrollY > 16 ? "true" : "false";
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("flex");
    menu?.classList.toggle("hidden", isOpen);
    menu?.classList.toggle("flex", !isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    })
  );
</script>

<style>
  #site-header[data-scrolled="true"] {
    background-color: color-mix(in srgb, var(--color-ink) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
</style>
